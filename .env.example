# All settings are server-side. No provider credential belongs in NEXT_PUBLIC_*.
# The default NHC feeds need no API key. Egress must allow:
# www.nhc.noaa.gov and mapservices.weather.noaa.gov

# Optional, reviewed utility polygon layer. Unset uses the bundled public HIFLD
# archive (2015–2023 source dates); set UTILITY_DISABLE_ARCHIVE=true to disable it.
# Leave an override unset until permission,
# source authority, coverage, source vintage and reuse terms are verified.
# Accepts HTTPS GeoJSON or an ArcGIS FeatureServer/MapServer polygon layer URL.
UTILITY_SERVICE_URL=
UTILITY_SOURCE_URL=
UTILITY_ATTRIBUTION=
UTILITY_LICENSE=
# ISO 8601 dataset vintage, not today's date unless genuinely published today.
UTILITY_SOURCE_DATE=
UTILITY_DISABLE_ARCHIVE=false
# Field names must match your actual provider. IDs must uniquely identify polygons.
UTILITY_FIELD_MAP={"id":"ID","name":"NAME","state":"STATE","type":"TYPE","customers":"CUSTOMERS","website":"WEBSITE","sourceDate":"SOURCEDATE","city":"CITY","customerYear":"YEAR","boundarySource":"SOURCE"}

# Optional administrator weights. All six required; nonnegative; sum = 100.
EXPOSURE_WEIGHTS={"wind":25,"territory":20,"customers":20,"infrastructure":15,"surge":10,"uncertainty":10}

# Optional persistent disk cache directory; defaults to .stormgrid-cache.
# STORMGRID_CACHE_DIR=/path/to/persistent/cache
